#!/bin/bash
# logwatch-ai — full-auto: every 15 min read NEW console output of all services;
# if real errors appear, launch Claude headless to diagnose + fix + restart.
# Cron-safe. State/offsets in ~/.cache/logwatch, report log logwatch.log
export PATH="$HOME/bin:$HOME/.local/bin:$HOME/.railway/bin:/usr/local/bin:/usr/bin:/bin"
CACHE=~/.cache/logwatch; mkdir -p "$CACHE"
LOG=$CACHE/logwatch.log
ERRS=$CACHE/new-errors.txt; : > "$ERRS"

FILES="$HOME/fivem/fxserver.log $HOME/fivem/watchdog.log $HOME/beammp/Server.log $HOME/azurite-data/azurite.log $HOME/twitter-dl/server.log"

for f in $FILES; do
  [ -f "$f" ] || continue
  key=$(echo "$f" | tr '/' '_')
  off_file="$CACHE/off$key"
  size=$(stat -c%s "$f")
  off=$(cat "$off_file" 2>/dev/null || echo 0)
  [ "$size" -lt "$off" ] && off=0            # log rotated/truncated
  if [ "$size" -gt "$off" ]; then
    tail -c +$((off+1)) "$f" | head -c 200000 |
      grep -aiE 'error|fatal|crash|exception|unhandled|refused|EADDRINUSE|out of memory' |
      grep -aivE 'hitch warning|Invalid code got in Identify' |
      head -40 | sed "s|^|[$(basename "$f")] |" >> "$ERRS"
  fi
  echo "$size" > "$off_file"
done

if [ ! -s "$ERRS" ]; then
  echo "$(date '+%F %T') all consoles clean" >> "$LOG"
  exit 0
fi

echo "=== $(date '+%F %T') NEW ERRORS ===" >> "$LOG"
cat "$ERRS" >> "$LOG"

claude -p --dangerously-skip-permissions "You are the auto log-watcher on this VPS. New console errors just appeared (file marked per line):

$(cat "$ERRS")

Diagnose each one. Services & controls: FiveM GTA (~/fivem, 'fivem doctor'/'fivem' CLI), BeamMP (~/beammp, 'beammp' CLI), local Azurite ('azlocal start|stop|status', log ~/azurite-data/azurite.log), twitter-dl web (~/twitter-dl, node server.js port 4310, cron watchdog). Fix what is really broken (restart service, fix config/code), IGNORE harmless noise, verify the fix (service responds / port listens). If you changed code in a git repo, commit and push. Append a 3-line max summary of what you did to ~/.cache/logwatch/logwatch.log" >> "$LOG" 2>&1

echo "=== logwatch-ai done $(date '+%F %T') ===" >> "$LOG"
